---
/**
 * The live date picker, in whichever framework the reader picked. Same
 * arrangement as `LiveCalendar.astro` — four islands, one visible. Angular's
 * playground is browser-tested, but no Angular island is embedded in Astro.
 */
import { DatePickerDemo as ReactDatePickerDemo } from './demos/react/DatePickerDemo'
import { DatePickerDemo as SolidDatePickerDemo } from './demos/solid/DatePickerDemo'
import SvelteDatePickerDemo from './demos/svelte/DatePickerDemo.svelte'
import VueDatePickerDemo from './demos/vue/DatePickerDemo.vue'

interface Props {
  /** Which theme the demo starts on. */
  theme?: string
}

const { theme = 'islamic' } = Astro.props
---

<div data-framework-example="vue">
  <VueDatePickerDemo client:visible theme={theme as never} />
</div>

<div data-framework-example="react">
  <ReactDatePickerDemo client:visible theme={theme as never} />
</div>

<div data-framework-example="svelte">
  <SvelteDatePickerDemo client:visible theme={theme as never} />
</div>

<div data-framework-example="solid">
  <SolidDatePickerDemo client:visible theme={theme as never} />
</div>

<div data-framework-example="angular">
  <div class="demo not-content">
    <div class="demo-stage demo-stage-note">
      <p>
        This documentation page does not embed an Angular date picker. The <code>playground/angular</code> app includes
        the date picker and its Hijri calendar switch. The shared Playwright suite exercises them in the browser, and
        Angular's strict template checks run during the build.
      </p>
    </div>
  </div>
</div>
