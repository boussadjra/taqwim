{
  "name": "@taqwim/vue-styled",
  "version": "0.1.0-beta.6",
  "private": false,
  "description": "Ready-to-use themed Vue 3 Hijri calendar and date picker",
  "keywords": [
    "calendar",
    "datepicker",
    "hijri",
    "islamic",
    "taqwim",
    "themes",
    "typescript",
    "vue"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git",
    "directory": "packages/vue-styled"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_comment": "build / test are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@taqwim/calendar-core": "workspace:*",
    "@taqwim/core": "workspace:*",
    "@taqwim/themes": "workspace:*",
    "@taqwim/vue": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "unplugin-vue": "^7.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.24",
    "vue-tsc": "^3.0.5"
  },
  "peerDependencies": {
    "vue": ">=3.3.0 <4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
