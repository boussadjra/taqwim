{
  "name": "@taqwim/react",
  "version": "0.1.0-alpha.2",
  "private": false,
  "description": "Headless React components for Hijri calendars, built on @taqwim/calendar-core",
  "keywords": [
    "accessibility",
    "calendar",
    "datepicker",
    "headless",
    "hijri",
    "islamic",
    "react",
    "taqwim",
    "typescript"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git",
    "directory": "packages/react"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_comment": "build / test are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@taqwim/calendar-core": "workspace:*",
    "@taqwim/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
