{
  "name": "@taqwim/svelte",
  "version": "0.1.0-beta.2",
  "private": false,
  "description": "Headless Svelte 5 components for Hijri calendars, built on @taqwim/calendar-core",
  "keywords": [
    "accessibility",
    "calendar",
    "datepicker",
    "headless",
    "hijri",
    "islamic",
    "runes",
    "svelte",
    "taqwim",
    "typescript"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_comment": "build / test are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@taqwim/calendar-core": "workspace:*",
    "@taqwim/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
