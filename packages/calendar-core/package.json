{
  "name": "@taqwim/calendar-core",
  "version": "0.1.0-beta.7",
  "private": false,
  "description": "Framework-agnostic Hijri calendar state machine: grid building, selection, keyboard navigation and accessibility props",
  "keywords": [
    "a11y",
    "calendar",
    "datepicker",
    "headless",
    "hijri",
    "islamic",
    "state-machine",
    "taqwim",
    "typescript"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git",
    "directory": "packages/calendar-core"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_comment": "build / test / test:coverage are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish"
  },
  "dependencies": {
    "@taqwim/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.14",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
