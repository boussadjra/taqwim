{
  "name": "@taqwim/vue",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "Headless Vue 3 components for Hijri calendars, built on @taqwim/calendar-core",
  "keywords": [
    "accessibility",
    "calendar",
    "datepicker",
    "headless",
    "hijri",
    "islamic",
    "taqwim",
    "typescript",
    "vue"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_comment": "build / test / type-check are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@taqwim/calendar-core": "workspace:*",
    "@taqwim/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsconfig/node20": "^20.1.6",
    "@tsdown/css": "^0.22.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "unplugin-vue": "^7.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.24",
    "vue-tsc": "^3.0.5"
  },
  "peerDependencies": {
    "vue": ">=3.3.0 <4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
