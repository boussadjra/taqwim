{
  "name": "taqwim-vue",
  "version": "0.0.5",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./hijri-calendar-variables.css": "./dist/style/hijri-calendar-variables.css",
    "./hijri-calendar.css": "./dist/style/hijri-calendar.css",
    "./hijri-calendar-dark.css": "./dist/style/hijri-calendar-dark.css",
    "./hijri-calendar-default.css": "./dist/style/hijri-calendar-default.css",
    "./hijri-calendar-islamic.css": "./dist/style/hijri-calendar-islamic.css",
    "./hijri-calendar-modern.css": "./dist/style/hijri-calendar-modern.css",
    "./hijri-calendar-neon.css": "./dist/style/hijri-calendar-neon.css",
    "./hijri-calendar-ocean.css": "./dist/style/hijri-calendar-ocean.css",
    "./hijri-calendar-sunset.css": "./dist/style/hijri-calendar-sunset.css",
    "./hijri-calendar-cyberpunk.css": "./dist/style/hijri-calendar-cyberpunk.css",
    "./hijri-calendar-nature.css": "./dist/style/hijri-calendar-nature.css",
    "./hijri-calendar-minimalist.css": "./dist/style/hijri-calendar-minimalist.css",
    "./hijri-calendar-luxurious.css": "./dist/style/hijri-calendar-luxurious.css",
    "./hijri-calendar-material.css": "./dist/style/hijri-calendar-material.css",
    "./minimal.css": "./dist/style/minimal.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build-only": "tsdown",
    "type-check": "vue-tsc --build --force",
    "prepublishOnly": "tsdown",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "taqwim-core-utils": "workspace:*",
    "vue": "^3.5.18"
  },
  "peerDependencies": {
    "vue": ">=3.3.0 <4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tsconfig/node20": "^20.1.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.43.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
    "unplugin-vue": "^7.0.0"
  },
  "keywords": [
    "taqwim",
    "taqwim-core-utils",
    "taqwim-vue",
    "taqwim-docs",
    "date",
    "hijri",
    "islamic",
    "calendar",
    "vue",
    "vite",
    "typescript"
  ],
  "files": [
    "dist",
    "src/index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git"
  }
}
