{
  "name": "@taqwim/solid",
  "version": "0.1.0-beta.3",
  "private": false,
  "description": "Headless Solid components for Hijri calendars, built on @taqwim/calendar-core",
  "keywords": [
    "accessibility",
    "calendar",
    "datepicker",
    "headless",
    "hijri",
    "islamic",
    "solid",
    "solid-js",
    "taqwim",
    "typescript"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/taqwim.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/source/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source/index.d.ts",
      "solid": "./dist/source/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "_comment": "build / test are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@taqwim/calendar-core": "workspace:*",
    "@taqwim/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "solid-js": "^1.9.14",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
