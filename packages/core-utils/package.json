{
  "name": "taqwim-core-utils",
  "version": "0.1.1",
  "private": false,
  "description": "Hijri Date utils",
  "keywords": [
    "backend",
    "calendar",
    "date",
    "hijri",
    "islamic",
    "nestjs",
    "nodejs",
    "server-side",
    "taqwim",
    "taqwim-core-utils",
    "taqwim-docs",
    "taqwim-vue",
    "typescript",
    "vite",
    "vue"
  ],
  "license": "MIT",
  "author": "Brahim Boussadjra",
  "repository": "https://github.com/boussadjra/taqwim",
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "_comment": "build / test / test:coverage are declared as vp tasks in vite.config.ts",
    "test:watch": "vp exec vitest",
    "prepublishOnly": "vp run build",
    "publish": "pnpm publish --access public"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
