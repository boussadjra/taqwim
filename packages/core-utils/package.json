{
  "name": "taqwim-core-utils",
  "version": "0.1.1",
  "private": false,
  "description": "Hijri Date utils",
  "author": "Brahim Boussadjra",
  "repository": "https://github.com/boussadjra/taqwim",
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "dev": "vite",
    "preview": "vite preview",
    "build:api": "jsdoc2md example.js > API.md",
    "prepublishOnly": "tsdown",
    "publish": "pnpm publish --access public",
    "analyse": "vite-bundle-visualizer dist --port 3000"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "rollup-plugin-visualizer": "^5.12.0"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "keywords": [
    "taqwim",
    "taqwim-core-utils",
    "taqwim-vue",
    "taqwim-docs",
    "date",
    "hijri",
    "islamic",
    "calendar",
    "vue",
    "vite",
    "typescript",
    "nodejs",
    "nestjs",
    "backend",
    "server-side"
  ]
}
