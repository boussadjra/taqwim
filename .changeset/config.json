{
  "$schema": "https://unpkg.com/@changesets/config@2.3.1/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "//": "Lockstep. Thirteen packages that only make sense together — an adapter and its store must never be a version apart — so one bump moves all of them.",
  "fixed": [
    [
      "@taqwim/core",
      "@taqwim/calendar-core",
      "@taqwim/themes",
      "@taqwim/vue",
      "@taqwim/vue-styled",
      "@taqwim/react",
      "@taqwim/react-styled",
      "@taqwim/svelte",
      "@taqwim/svelte-styled",
      "@taqwim/solid",
      "@taqwim/solid-styled",
      "@taqwim/angular",
      "@taqwim/angular-styled"
    ]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "taqwim-docs",
    "taqwim-playground-vue",
    "taqwim-playground-react",
    "taqwim-playground-svelte",
    "taqwim-playground-solid",
    "taqwim-playground-angular",
    "taqwim-core-utils",
    "taqwim-vue"
  ]
}
